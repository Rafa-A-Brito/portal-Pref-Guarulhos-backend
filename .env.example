PORT=3333
DATABASE_URL=postgresql://usuario:senha@localhost:5432/patrimonio_guarulhos
CORS_ORIGIN=http://localhost:5173
# Preencha localmente com um segredo aleatório de pelo menos 32 caracteres.
JWT_SECRET=
JWT_TTL_SECONDS=900

# Pasta raiz das mídias enviadas. Em produção aponte para o volume que entra no backup.
UPLOAD_ROOT=uploads
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=10485760
